{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Read and manage shell profiles at absolute paths accessible to the current OS user.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "fs:allow-exists",
    "fs:allow-lstat",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "/" }, { "path": "/**" }]
    }
  ]
}
